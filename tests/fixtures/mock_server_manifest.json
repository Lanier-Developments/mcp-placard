  "surface": {
    "instructions": "Workspace assistant. Use search_documents before answering questions about project files. Prefer write_note over delete_workspace when unsure.",
    "prompts": [
      {
        "arguments": [
          {
            "description": "Thread identifier.",
            "name": "thread_id",
            "required": true
          }
        ],
        "description": "Summarize a document discussion thread for a reader who missed it.",
        "name": "summarize_thread",
        "title": "Summarize thread"
      },
      {
        "arguments": [
          {
            "description": "Incident identifier.",
            "name": "incident_id",
            "required": true
          },
          {
            "description": "Reported severity.",
            "name": "severity",
            "required": false
          }
        ],
        "description": "Draft a triage summary for an incident from its timeline.",
        "name": "triage_incident",
        "title": "Triage incident"
      }
    ],
    "resource_templates": [
      {
        "description": "Any file beneath the configured workspace root.",
        "mimeType": "text/plain",
        "name": "workspace_file",
        "title": "Workspace file",
        "uriTemplate": "file:///workspace/{path}"
      }
    ],
    "resources": [
      {
        "description": "Column definitions for the customers table.",
        "mimeType": "application/json",
        "name": "customer_schema",
        "title": "Customer table schema",
        "uri": "db://workspace/customers/schema"
      },
      {
        "description": "Top-level workspace readme.",
        "mimeType": "text/markdown",
        "name": "workspace_readme",
        "size": 2048,
        "title": "Workspace README",
        "uri": "file:///workspace/README.md"
      }
    ],
    "server": {
      "name": "placard-mock",
      "title": "Placard Mock Workspace Server",
      "version": "1.4.2"
    },
