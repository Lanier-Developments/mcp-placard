{
  "name": "traverse_tree",
  "description": "Operate on a self-referencing tree structure.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "root": { "$ref": "#/$defs/Node" }
    },
    "$defs": {
      "Node": {
